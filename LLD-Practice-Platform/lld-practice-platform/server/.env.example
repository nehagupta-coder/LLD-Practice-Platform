# Port the API server listens on
PORT=4000

# memory (default, no setup needed) | mongo (requires MONGODB_URI, see README)
DB_MODE=mongo
MONGO_URI=mongodb+srv://lld:1nVbhnTwI6h9JFIz@cluster0.vnwrsed.mongodb.net/lld-platform?retryWrites=true&w=majority
